# Engines: fake | piper | openai  /  fake | faster_whisper | openai
READBACK_TTS_PROVIDER=fake
READBACK_STT_PROVIDER=fake

# Review stage: rules | llm | cascade
READBACK_REVIEWER=rules
# Any init_chat_model id, e.g. azure_openai:<deployment> or anthropic:claude-sonnet-5-5
READBACK_LLM_MODEL=anthropic:claude-opus-5-5
READBACK_LLM_EFFORT=low
# ANTHROPIC_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# OPENAI_API_VERSION=2025-04-01-preview

# Fake engines (offline demo / evaluation)
READBACK_FAKE_FAULT_RATE=0.25
READBACK_FAKE_STICKY_FAULT_RATE=0.08
READBACK_FAKE_NOISE_RATE=0.35

# Tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=readback
